{
  "name": "loyal-yield-routing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.17",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "ci:wait-main": "bash scripts/wait-for-main-workflow.sh",
    "same-mint:alt-cleanup-paginated": "bun scripts/route-lookup-table-cleanup-paginated.ts",
    "hub:cli": "cargo run -p loyal-hub-cli --",
    "hub:devnet-smoke": "bash scripts/devnet-test-loyal-hub-swap-program.sh",
    "jupiter:swap": "bun scripts/jupiter-wallet-swap.mjs",
    "yield:migrate": "cd go/workers && go run ./cmd/loyal-migrate -db yield up",
    "yield:migrate:check": "cd go/workers && go run ./cmd/loyal-migrate -db yield status",
    "timescale:migrate": "cd go/workers && go run ./cmd/loyal-migrate -db timescale up",
    "timescale:migrate:check": "cd go/workers && go run ./cmd/loyal-migrate -db timescale status",
    "test:squads": "cargo build-sbf -- -p mock-yield-protocols-program -p loyal-hub-swap-program && cargo test -p squads-test-harness",
    "test:squads:e2e": "cargo build-sbf -- -p mock-yield-protocols-program -p loyal-hub-swap-program && cargo test -p squads-test-harness --test kamino_hindsight_e2e -- --ignored --nocapture",
    "test:squads:hub-hindsight": "cargo build-sbf -- -p mock-yield-protocols-program -p loyal-hub-swap-program && cargo test -p squads-test-harness --test loyal_hub_hindsight_e2e -- --ignored --nocapture",
    "verify:cross-mint:jupiter-live": "JUPITER_LIVE_CROSS_MINT=1 cargo test -p squads-test-harness --test jupiter_live_cross_mint -- --ignored --nocapture",
    "verify:cross-mint:jupiter-matrix": "JUPITER_LIVE_CROSS_MINT_MATRIX=1 cargo test -p squads-test-harness --test jupiter_live_cross_mint_matrix -- --ignored --nocapture",
    "verify:cross-mint:jupiter-mainnet": "CROSS_MINT_MAINNET_POLICY_EXECUTE=1 cargo test -p squads-test-harness --test jupiter_mainnet_cross_mint_policy generalized_policy_set_executes_and_reconciles_on_mainnet -- --ignored --nocapture",
    "verify:cross-mint:routes-mainnet": "CROSS_MINT_MAINNET_ROUTES_EXECUTE=1 cargo test -p squads-test-harness --test jupiter_mainnet_cross_mint_policy historical_withdraw_swap_deposit_routes_finalize_on_mainnet -- --ignored --nocapture",
    "verify:multiply-guard-retirement": "bun scripts/verify-multiply-guard-retirement.ts",
    "backfill:rwa-observation-history": "bun scripts/backfill-rwa-observation-history.ts",
    "promote:cross-mint:production-baseline": "bun scripts/promote-cross-mint-production-baseline.ts",
    "verify:hub-abi-spec-drift": "cargo test -p loyal-hub-abi -- --nocapture",
    "verify:qedgen:check": "bash scripts/verify-qedgen-check.sh",
    "verify:qedgen:probe": "bash scripts/verify-qedgen-probe.sh",
    "verify:qedgen:proptest": "bash scripts/verify-qedgen-proptest.sh",
    "verify:qedgen:kani": "bash scripts/verify-qedgen-kani.sh",
    "verify:qedgen:kani:full": "KANI_SCOPE=full bash scripts/verify-qedgen-kani.sh",
    "verify:qedgen:kani-impl": "bash scripts/verify-qedgen-kani-impl.sh",
    "verify:qedgen:kani-impl:full": "KANI_IMPL_SCOPE=full bash scripts/verify-qedgen-kani-impl.sh",
    "verify:hub-kani-impl": "bash scripts/verify-hub-kani-impl.sh",
    "verify:farm-state-rent-recovery": "bun scripts/verify-farm-state-rent-recovery.ts",
    "verify:realtime:sse": "bun scripts/verify-realtime-sse-smoke.ts",
    "verify:reusable-alts:routes": "cargo test -p squads-test-harness --test reusable_alt_v0_matrix -- --nocapture",
    "verify:qedgen": "bun run verify:hub-abi-spec-drift && bun run verify:qedgen:check && bun run verify:qedgen:probe && bun run verify:qedgen:proptest"
  },
  "dependencies": {
    "@loyal-labs/loyal-smart-accounts": "0.1.1",
    "@loyal-labs/loyal-smart-accounts-core": "0.1.1",
    "@loyal-labs/smart-account-vaults": "0.1.2",
    "@loyal/actions": "npm:@loyal-labs/actions@0.1.1",
    "@neondatabase/serverless": "^1.1.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
