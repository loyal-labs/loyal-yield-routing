    "verify:rwa-observation-v1": "bun scripts/verify-rwa-observation.ts",
    "backfill:rwa-observation-history": "bun scripts/backfill-rwa-observation-history.ts",
    "verify:rwa-observation-backfill-v1": "bun scripts/verify-rwa-observation-backfill.ts",
    "rwa:decision-shadow": "bun scripts/rwa-decision-shadow.ts",
    "verify:rwa-decision-v1": "bun scripts/verify-rwa-decision.ts",
