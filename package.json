{
  "name": "loyal-yield-routing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.17",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "autodeposit:execute": "bun scripts/execute-autodeposit-policy.ts",
    "autodeposit:test": "bun test scripts/execute-autodeposit-policy.test.ts",
    "same-mint:swap": "cargo run -p loyal-yield-orchestrator --bin same-mint-reserve-swap --",
    "same-mint:monitor": "cargo run -p loyal-yield-orchestrator --bin same-mint-yield-monitor --",
    "same-mint:monitor-e2e": "cargo run -p loyal-yield-orchestrator --bin same-mint-monitor-e2e --",
    "balance-sweep:trigger": "cargo run -p balance-sweep-autodeposit-trigger",
    "balance-sweep:project": "cargo run -p balance-sweep-ata-projector",
    "hub:cli": "cargo run -p loyal-hub-cli --",
    "hub:devnet-smoke": "bash scripts/devnet-test-loyal-hub-swap-program.sh",
    "loyal-actions:build": "bun run --cwd packages/loyal-actions build",
    "loyal-actions:test": "bun run --cwd packages/loyal-actions test",
    "loyal-actions:typecheck": "bun run --cwd packages/loyal-actions typecheck",
    "yield:migrate": "cargo run -p loyal-yield-orchestrator --bin yield-migrations",
    "yield:migrate:check": "cargo run -p loyal-yield-orchestrator --bin yield-migrations -- --check",
    "timescale:migrate": "cargo run -p loyal-timescale-migrations",
    "timescale:migrate:check": "cargo run -p loyal-timescale-migrations -- --check",
    "test:squads": "cargo build-sbf -- -p mock-yield-protocols-program -p loyal-hub-swap-program && cargo test -p squads-test-harness",
    "test:squads:e2e": "cargo build-sbf -- -p mock-yield-protocols-program -p loyal-hub-swap-program && cargo test -p squads-test-harness --test kamino_hindsight_e2e -- --ignored --nocapture",
    "test:squads:hub-hindsight": "cargo build-sbf -- -p mock-yield-protocols-program -p loyal-hub-swap-program && cargo test -p squads-test-harness --test loyal_hub_hindsight_e2e -- --ignored --nocapture",
    "verify:hub-abi-spec-drift": "cargo test -p loyal-hub-abi -- --nocapture",
    "verify:qedgen:check": "bash scripts/verify-qedgen-check.sh",
    "verify:qedgen:probe": "bash scripts/verify-qedgen-probe.sh",
    "verify:qedgen:proptest": "bash scripts/verify-qedgen-proptest.sh",
    "verify:qedgen:kani": "bash scripts/verify-qedgen-kani.sh",
    "verify:qedgen:kani:full": "KANI_SCOPE=full bash scripts/verify-qedgen-kani.sh",
    "verify:qedgen:kani-impl": "bash scripts/verify-qedgen-kani-impl.sh",
    "verify:qedgen:kani-impl:full": "KANI_IMPL_SCOPE=full bash scripts/verify-qedgen-kani-impl.sh",
    "verify:hub-kani-impl": "bash scripts/verify-hub-kani-impl.sh",
    "verify:qedgen": "bun run verify:hub-abi-spec-drift && bun run verify:qedgen:check && bun run verify:qedgen:probe && bun run verify:qedgen:proptest"
  },
  "dependencies": {
    "@loyal-labs/loyal-smart-accounts": "0.1.1",
    "@loyal-labs/loyal-smart-accounts-core": "0.1.1",
    "@loyal-labs/smart-account-vaults": "0.1.1",
    "@loyal/actions": "npm:@loyal-labs/actions@0.1.0",
    "@neondatabase/serverless": "^1.1.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
