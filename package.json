    "verify:cross-mint:routes-mainnet": "CROSS_MINT_MAINNET_ROUTES_EXECUTE=1 cargo test -p squads-test-harness --test jupiter_mainnet_cross_mint_policy historical_withdraw_swap_deposit_routes_finalize_on_mainnet -- --ignored --nocapture",
