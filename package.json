    "verify:fleet-health-poll": "bash scripts/verify-fleet-health-poll-contention.sh",
    "verify:earn-rebalance-success-metrics": "bun scripts/verify-earn-rebalance-success-metrics.ts",
    "verify:ask-2222-conflict-ownership-e2e": "bash scripts/verify-ask-2222-conflict-ownership-e2e.sh",
    "verify:fleet-latency-speedup-e2e": "bash scripts/verify-fleet-latency-speedup-e2e.sh",
    "verify:ask-1973-fleet-e2e": "bash scripts/verify-ask-1973-fleet-e2e.sh",
    "verify:earn-fleet-local-e2e": "bash scripts/verify-earn-fleet-local-e2e.sh",
    "verify:ask-1973-images": "bash scripts/verify-ask-1973-images.sh",
    "verify:ask-1973-public-api": "bash scripts/verify-ask-1973-public-api.sh",
    "verify:ask-1973-clickstack": "bash scripts/verify-ask-1973-clickstack.sh",
    "verify:ask-1973-deployment": "bash scripts/verify-ask-1973-deployment.sh",
    "verify:admin-rebalance-index": "bash scripts/verify-admin-rebalance-index.sh",
    "verify:reusable-alts": "bash scripts/verify-reusable-alts.sh",
