    "verify:reusable-alts:db": "cargo run -p loyal-yield-orchestrator --bin verify-reusable-alt-db",
    "verify:reusable-alts:routes": "cargo test -p squads-test-harness --test reusable_alt_v0_matrix -- --nocapture",
    "verify:qedgen": "bun run verify:hub-abi-spec-drift && bun run verify:qedgen:check && bun run verify:qedgen:probe && bun run verify:qedgen:proptest"
