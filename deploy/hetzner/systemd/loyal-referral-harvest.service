[Unit]
Description=Harvest eligible Earn MAX admin fees
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# With no execution argument, the CLI simulates using just the public payer.
Environment=HARVEST_EXECUTION_ARGUMENT=
EnvironmentFile=/etc/loyal/loyal-referral-harvest.env
ExecStart=/opt/loyal/releases/referral-harvest/current/loyal-referral-harvest $HARVEST_EXECUTION_ARGUMENT
LoadCredentialEncrypted=REFERRAL_HARVEST_DATABASE_URL:/etc/credstore.encrypted/loyal-referral-harvest/REFERRAL_HARVEST_DATABASE_URL
LoadCredentialEncrypted=REFERRAL_HARVEST_RPC_URL:/etc/credstore.encrypted/loyal-referral-harvest/REFERRAL_HARVEST_RPC_URL
DynamicUser=yes
User=loyal-referral-harvest
StateDirectory=loyal-referral-harvest
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=5min
LimitCORE=0
MemoryMax=256M
TasksMax=64
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
