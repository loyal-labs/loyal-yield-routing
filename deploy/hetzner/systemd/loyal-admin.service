# Loyal admin (Go). One static binary: the Vite build of web/apps/admin is
# embedded in it and it answers the admin API itself. It listens on loopback
# only; a tunnel hostname carries the admin host to it once its ingress exists.
# Releases ship in /opt/loyal/releases/admin/<sha>/loyal-admin and are switched
# by scripts/deploy-workers.sh through the 40-verified-release.conf drop-in.
# Credentials come from the loyal-admin credstore (see README): ADMIN_USER,
# ADMIN_PASSWORD and ADMIN_APP_DATABASE_URL are required; each optional one
# missing disables only the pages that need it.
[Unit]
Description=Loyal admin (Go)
Documentation=https://github.com/loyal-labs/loyal-yield-routing/tree/main/deploy/hetzner
Wants=network-online.target
After=network-online.target
# Never give up restarting; restart loops are an alert, not a stop.
StartLimitIntervalSec=0

[Service]
Type=exec
# Placeholder release path; the verified-release drop-in overrides it, as on
# the other units (see loyal-observer.service).
ExecStart=/opt/loyal/bin/loyal-admin
Restart=on-failure
RestartSec=5s
TimeoutStopSec=60s

Environment=LOYAL_ADMIN_ADDRESS=127.0.0.1:10081
# Every other LOYAL_ADMIN_* and *_PUBLIC_KEY name is set in a host drop-in
# (60-env.conf) outside the repo; the list is in the README.
LoadCredentialEncrypted=ADMIN_USER:/etc/credstore.encrypted/loyal-admin-user
LoadCredentialEncrypted=ADMIN_PASSWORD:/etc/credstore.encrypted/loyal-admin-password
LoadCredentialEncrypted=ADMIN_APP_DATABASE_URL:/etc/credstore.encrypted/loyal-admin-app-db

DynamicUser=yes
User=loyal-admin
StandardOutput=journal
StandardError=journal
SyslogIdentifier=loyal-admin

MemoryMax=256M
CPUWeight=20
CPUQuota=100%
Nice=15
TasksMax=256
LimitCORE=0

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
