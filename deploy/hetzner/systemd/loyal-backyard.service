# Backyard family. Separately credentialed engine instance.
# Secrets: systemd-creds encrypted with the host key; names only here.
[Unit]
Description=Loyal Backyard engine (Go)
Documentation=https://github.com/loyal-labs/loyal-yield-routing/tree/main/deploy/hetzner
Wants=network-online.target
After=network-online.target
# Never give up restarting; restart loops are an alert, not a stop.
StartLimitIntervalSec=0

[Service]
Type=exec
ExecStart=/opt/loyal/bin/loyal-engine
Restart=always
RestartSec=5s
# A stop leaves signed rows on the operation table; the next start lands them.
TimeoutStopSec=60s

LoadCredentialEncrypted=BACKYARD_DATABASE_URL:/etc/credstore.encrypted/loyal-backyard/BACKYARD_DATABASE_URL
LoadCredentialEncrypted=BACKYARD_SOLANA_RPC_URL:/etc/credstore.encrypted/loyal-backyard/BACKYARD_SOLANA_RPC_URL
LoadCredentialEncrypted=BACKYARD_POLICY_KEYPAIR:/etc/credstore.encrypted/loyal-backyard/BACKYARD_POLICY_KEYPAIR

Environment=LOYAL_WORKER_SCOPE=backyard
Environment=LOYAL_WORKER_INSTANCE=primary
Environment=LOYAL_METRICS_ADDRESS=127.0.0.1:9103

DynamicUser=yes
User=loyal-backyard
StandardOutput=journal
StandardError=journal
SyslogIdentifier=loyal-backyard

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
