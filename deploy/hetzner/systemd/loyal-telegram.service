# Loyal Telegram bot (Go). Answers the @askloyal_tgbot webhook on
# /telegram/webhook and /api/telegram/webhook and runs the helper-message
# cleanup every minute. One replica only. It listens on loopback; the tunnel
# carries the webhook host to it.
# Releases ship in /opt/loyal/releases/telegram/<sha>/loyal-telegram and are
# switched through the 40-verified-release.conf drop-in, as on the other units.
# Credentials come from the loyal-telegram credstore; all three are required.
[Unit]
Description=Loyal Telegram bot (Go)
Documentation=https://github.com/loyal-labs/loyal-yield-routing/tree/main/deploy/hetzner
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=exec
ExecStart=/opt/loyal/bin/loyal-telegram
Restart=on-failure
RestartSec=5s
TimeoutStopSec=6min

Environment=LOYAL_TELEGRAM_ADDRESS=127.0.0.1:10083
LoadCredentialEncrypted=TELEGRAM_APP_DATABASE_URL:/etc/credstore.encrypted/loyal-telegram/TELEGRAM_APP_DATABASE_URL
LoadCredentialEncrypted=TELEGRAM_BOT_TOKEN:/etc/credstore.encrypted/loyal-telegram/TELEGRAM_BOT_TOKEN
LoadCredentialEncrypted=TELEGRAM_WEBHOOK_SECRET:/etc/credstore.encrypted/loyal-telegram/TELEGRAM_WEBHOOK_SECRET

DynamicUser=yes
User=loyal-telegram
StandardOutput=journal
StandardError=journal
SyslogIdentifier=loyal-telegram

MemoryMax=256M
CPUWeight=20
CPUQuota=100%
Nice=15
TasksMax=256
LimitCORE=0

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
