# Loyal web (loyal-web.service) behind Caddy. Paste this site block into
# /etc/caddy/Caddyfile next to realtime.askloyal.com's, then follow
# deploy/hetzner/README.md, "Web (loyal-web)": validate, reload, recheck the
# neighbour site.
next.askloyal.com {
	tls {
		issuer acme {
			# As on realtime.askloyal.com.
			disable_tlsalpn_challenge
		}
	}
	# Vercel serves the bundle compressed; so does this. Named types only, so
	# an SSE stream (text/event-stream) is never compressed or buffered. One
	# type per line: a header line is a field and a single value.
	encode {
		zstd
		gzip
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/plain*
			header Content-Type text/xml*
			header Content-Type text/javascript*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type application/xml*
			header Content-Type application/manifest+json*
			header Content-Type image/svg+xml*
		}
	}
	reverse_proxy 127.0.0.1:10080 {
		# The Go proxy forwards SSE streams; never buffer them.
		flush_interval -1
	}
}
