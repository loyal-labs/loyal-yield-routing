# Loyal web (loyal-web.service) behind Caddy. Paste this site block into
# /etc/caddy/Caddyfile next to realtime.askloyal.com's, then follow
# deploy/hetzner/README.md, "Web (loyal-web)": validate, reload, recheck the
# neighbour site.
next.askloyal.com {
	tls {
		issuer acme {
			# As on realtime.askloyal.com.
			disable_tlsalpn_challenge
		}
	}
	# Vercel serves the bundle compressed; so does this. Named types only, so
	# an SSE stream (text/event-stream) is never compressed or buffered.
	encode {
		zstd
		gzip
		match {
			header Content-Type text/html* text/css* text/plain* text/xml* text/javascript* application/javascript* application/json* application/xml* application/manifest+json* image/svg+xml*
		}
	}
	reverse_proxy 127.0.0.1:10080 {
		# The Go proxy forwards SSE streams; never buffer them.
		flush_interval -1
	}
}
