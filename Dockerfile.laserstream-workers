# syntax=docker/dockerfile:1.7

FROM rust:1.89-bookworm AS chef

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        clang \
        git \
        libssl-dev \
        pkg-config \
        protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

RUN cargo install cargo-chef --locked
WORKDIR /app

FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
COPY --from=planner /app/recipe.json recipe.json
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    cargo chef cook --release \
        -p kamino-reserve-monitor \
        -p balance-sweep-ata-monitor \
        -p loyal-timescale-migrations \
        --recipe-path recipe.json \
    && cargo chef cook --release \
        -p loyal-yield-orchestrator \
        --bin yield-migrations \
        --recipe-path recipe.json

COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    cargo build --release \
        -p kamino-reserve-monitor \
        -p balance-sweep-ata-monitor \
        -p loyal-timescale-migrations \
    && cargo build --release \
        -p loyal-yield-orchestrator \
        --bin yield-migrations \
    && cp /app/target/release/kamino-reserve-monitor /usr/local/bin/kamino-reserve-monitor \
    && cp /app/target/release/balance-sweep-ata-monitor /usr/local/bin/balance-sweep-ata-monitor \
    && cp /app/target/release/loyal-timescale-migrations /usr/local/bin/loyal-timescale-migrations \
    && cp /app/target/release/yield-migrations /usr/local/bin/yield-migrations

FROM debian:bookworm-slim AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/bin/kamino-reserve-monitor /usr/local/bin/kamino-reserve-monitor
COPY --from=builder /usr/local/bin/balance-sweep-ata-monitor /usr/local/bin/balance-sweep-ata-monitor
COPY --from=builder /usr/local/bin/loyal-timescale-migrations /usr/local/bin/loyal-timescale-migrations
COPY --from=builder /usr/local/bin/yield-migrations /usr/local/bin/yield-migrations
COPY --chmod=0755 scripts/kamino-monitor-predeploy.sh /usr/local/bin/kamino-monitor-predeploy

CMD ["/usr/local/bin/kamino-reserve-monitor"]
