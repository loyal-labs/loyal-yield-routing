# syntax=docker/dockerfile:1.7

# Rust compilation happens once in rust-image-build.yml. This Dockerfile only
# assembles the runtime image from the workflow artifact.
FROM debian:bookworm-slim AS runtime

ARG LOYAL_IMAGE_VERSION
ENV LOYAL_IMAGE_VERSION=${LOYAL_IMAGE_VERSION}

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --chmod=0755 build-artifacts/rust/kamino-reserve-monitor /usr/local/bin/kamino-reserve-monitor
COPY --chmod=0755 build-artifacts/rust/balance-sweep-ata-monitor /usr/local/bin/balance-sweep-ata-monitor
COPY --chmod=0755 build-artifacts/rust/loyal-timescale-migrations /usr/local/bin/loyal-timescale-migrations
COPY --chmod=0755 build-artifacts/rust/yield-migrations /usr/local/bin/yield-migrations
COPY --chmod=0755 scripts/kamino-monitor-predeploy.sh /usr/local/bin/kamino-monitor-predeploy

CMD ["/usr/local/bin/kamino-reserve-monitor"]
