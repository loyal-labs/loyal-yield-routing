# Helius RPC/API access for Solana data and transaction flows.
HELIUS_API_KEY=
LASERSTREAM_ENDPOINT=https://laserstream-mainnet-ewr.helius-rpc.com
KAMINO_UPDATE_SOURCE=laserstream
SOLANA_RPC_URL=
# Optional fallback when KAMINO_UPDATE_SOURCE=websocket.
SOLANA_WS_URL=

# TimescaleDB connection string for the separate Kamino market-data Neon database.
TIMESCALEDB_URL=

# Neon Postgres connection string for Loyal vault state and orchestration data.
NEON_DATABASE_URL=

# Solana delegated yield router signer private key, stored in 1Password.
# Accepts a 32-byte private seed or 64-byte keypair encoded as hex, base58, base64, or JSON array.
YIELD_ROUTER_KEYPAIR=
