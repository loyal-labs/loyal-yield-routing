# Helius RPC/API access for Solana data and transaction flows.
HELIUS_API_KEY=
LASERSTREAM_ENDPOINT=https://laserstream-mainnet-ewr.helius-rpc.com
KAMINO_UPDATE_SOURCE=laserstream
SOLANA_RPC_URL=
# Optional fallback when KAMINO_UPDATE_SOURCE=websocket.
SOLANA_WS_URL=

# TimescaleDB connection string for the separate Kamino market-data Neon database.
TIMESCALEDB_URL=
# Balance-sweep ATA Timescale stream. Use `production` for production and
# `staging` for staging; this selects the environment-specific ATA tables inside
# the shared TimescaleDB.
BALANCE_SWEEP_ATA_STREAM=production

# Neon Postgres connection string for Loyal vault state and orchestration data.
NEON_DATABASE_URL=

# Solana delegated yield router signer private key, stored in 1Password as hex.
# Accepts a 32-byte private seed or a 64-byte Solana keypair encoded as hex.
YIELD_ROUTER_KEYPAIR=

# Optional post-autosweep notification. Secret value should come from 1Password.
SOLANA_WEEK_NOTIFY_ENDPOINT=https://askloyal.com/api/solana-week/sweep-notify
SOLANA_WEEK_NOTIFY_SECRET=
