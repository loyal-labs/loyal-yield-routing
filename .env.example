# Helius RPC/API access for Solana data and transaction flows.
HELIUS_API_KEY=

# TimescaleDB connection string for Kamino reserve history and APY data.
TIMESCALEDB_URL=

# Neon Postgres connection string for Loyal vault state and orchestration data.
NEON_DATABASE_URL=

# Solana delegated yield router signer private key, stored in 1Password as hex.
# Accepts a 32-byte private seed or a 64-byte Solana keypair encoded as hex.
YIELD_ROUTER_KEYPAIR=
