# syntax=docker/dockerfile:1.7

FROM oven/bun:1.2.17-debian AS bun-deps

WORKDIR /app
COPY package.json bun.lock ./
RUN --mount=type=cache,target=/root/.bun/install/cache \
    bun install --production --frozen-lockfile

# Rust compilation happens once in rust-image-build.yml. This Dockerfile only
# assembles the runtime image from the workflow artifact and Bun dependencies.
FROM debian:bookworm-slim AS runtime

ARG LOYAL_IMAGE_VERSION
ENV LOYAL_IMAGE_VERSION=${LOYAL_IMAGE_VERSION}

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=bun-deps /usr/local/bin/bun /usr/local/bin/bun
COPY --from=bun-deps /app/package.json /app/bun.lock ./
COPY --from=bun-deps /app/node_modules ./node_modules
COPY scripts/execute-autodeposit-policy.ts scripts/execute-autodeposit-policy.ts
COPY scripts/autodeposit-idle-vault-handoff.ts scripts/autodeposit-idle-vault-handoff.ts
COPY scripts/durable-autodeposit-confirmation.ts scripts/durable-autodeposit-confirmation.ts
COPY --chmod=0755 build-artifacts/rust/balance-sweep-ata-projector /usr/local/bin/balance-sweep-ata-projector
COPY --chmod=0755 build-artifacts/rust/balance-sweep-autodeposit-trigger /usr/local/bin/balance-sweep-autodeposit-trigger
COPY --chmod=0755 build-artifacts/rust/loyal-yield-realtime /usr/local/bin/loyal-yield-realtime
COPY --chmod=0755 build-artifacts/rust/loyal-squads-policy-monitor /usr/local/bin/loyal-squads-policy-monitor
COPY --chmod=0755 build-artifacts/rust/yield-migrations /usr/local/bin/yield-migrations
COPY --chmod=0755 build-artifacts/rust/same-mint-reserve-swap /usr/local/bin/same-mint-reserve-swap
COPY --chmod=0755 build-artifacts/rust/same-mint-yield-monitor /usr/local/bin/same-mint-yield-monitor
COPY --chmod=0755 build-artifacts/rust/fleet-opportunity-planner /usr/local/bin/fleet-opportunity-planner
COPY --chmod=0755 build-artifacts/rust/fleet-health-projector /usr/local/bin/fleet-health-projector
COPY --chmod=0755 build-artifacts/rust/fleet-route-confirmer /usr/local/bin/fleet-route-confirmer
COPY --chmod=0755 build-artifacts/rust/route-lookup-table-provisioner /usr/local/bin/route-lookup-table-provisioner

CMD ["/usr/local/bin/balance-sweep-ata-projector"]
