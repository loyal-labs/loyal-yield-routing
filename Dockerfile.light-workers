# syntax=docker/dockerfile:1.7

FROM rust:1.89-bookworm AS chef

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        clang \
        git \
        libssl-dev \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN cargo install cargo-chef --locked
WORKDIR /app

FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
COPY --from=planner /app/recipe.json recipe.json
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    cargo chef cook --release \
        -p balance-sweep-ata-projector \
        -p balance-sweep-autodeposit-trigger \
        -p loyal-timescale-migrations \
        -p loyal-yield-realtime \
        --recipe-path recipe.json \
    && cargo chef cook --release \
        -p loyal-yield-orchestrator \
        --bin yield-migrations \
        --bin same-mint-reserve-swap \
        --bin same-mint-yield-monitor \
        --bin fleet-opportunity-planner \
        --bin fleet-orchestration-verifier \
        --bin fleet-orchestration-production-evidence \
        --bin fleet-route-confirmer \
        --bin same-mint-monitor-e2e \
        --bin route-lookup-table-shared-catalog \
        --bin route-lookup-table-provisioner \
        --bin route-lookup-table-alert-monitor \
        --bin route-lookup-table-legacy-import \
        --bin route-lookup-table-cleanup \
        --recipe-path recipe.json

COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    cargo build --release \
        -p balance-sweep-ata-projector \
        -p balance-sweep-autodeposit-trigger \
        -p loyal-timescale-migrations \
        -p loyal-yield-realtime \
    && cargo build --release \
        -p loyal-yield-orchestrator \
        --bin yield-migrations \
        --bin same-mint-reserve-swap \
        --bin same-mint-yield-monitor \
        --bin fleet-opportunity-planner \
        --bin fleet-orchestration-verifier \
        --bin fleet-orchestration-production-evidence \
        --bin fleet-route-confirmer \
        --bin same-mint-monitor-e2e \
        --bin route-lookup-table-shared-catalog \
        --bin route-lookup-table-provisioner \
        --bin route-lookup-table-alert-monitor \
        --bin route-lookup-table-legacy-import \
        --bin route-lookup-table-cleanup \
    && cp /app/target/release/balance-sweep-ata-projector /usr/local/bin/balance-sweep-ata-projector \
    && cp /app/target/release/balance-sweep-autodeposit-trigger /usr/local/bin/balance-sweep-autodeposit-trigger \
    && cp /app/target/release/loyal-yield-realtime /usr/local/bin/loyal-yield-realtime \
    && cp /app/target/release/loyal-timescale-migrations /usr/local/bin/loyal-timescale-migrations \
    && cp /app/target/release/yield-migrations /usr/local/bin/yield-migrations \
    && cp /app/target/release/same-mint-reserve-swap /usr/local/bin/same-mint-reserve-swap \
    && cp /app/target/release/same-mint-yield-monitor /usr/local/bin/same-mint-yield-monitor \
    && cp /app/target/release/fleet-opportunity-planner /usr/local/bin/fleet-opportunity-planner \
    && cp /app/target/release/fleet-orchestration-verifier /usr/local/bin/fleet-orchestration-verifier \
    && cp /app/target/release/fleet-orchestration-production-evidence /usr/local/bin/fleet-orchestration-production-evidence \
    && cp /app/target/release/fleet-route-confirmer /usr/local/bin/fleet-route-confirmer \
    && cp /app/target/release/same-mint-monitor-e2e /usr/local/bin/same-mint-monitor-e2e \
    && cp /app/target/release/route-lookup-table-shared-catalog /usr/local/bin/route-lookup-table-shared-catalog \
    && cp /app/target/release/route-lookup-table-provisioner /usr/local/bin/route-lookup-table-provisioner \
    && cp /app/target/release/route-lookup-table-alert-monitor /usr/local/bin/route-lookup-table-alert-monitor \
    && cp /app/target/release/route-lookup-table-legacy-import /usr/local/bin/route-lookup-table-legacy-import \
    && cp /app/target/release/route-lookup-table-cleanup /usr/local/bin/route-lookup-table-cleanup

FROM oven/bun:1.2.17-debian AS bun-deps

WORKDIR /app
COPY package.json bun.lock ./
COPY packages/loyal-actions/package.json packages/loyal-actions/package.json
RUN --mount=type=cache,target=/root/.bun/install/cache \
    bun install --production --frozen-lockfile

FROM debian:bookworm-slim AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=bun-deps /usr/local/bin/bun /usr/local/bin/bun
COPY --from=bun-deps /app/package.json /app/bun.lock ./
COPY --from=bun-deps /app/node_modules ./node_modules
COPY packages/loyal-actions packages/loyal-actions
COPY scripts/execute-autodeposit-policy.ts scripts/execute-autodeposit-policy.ts
COPY --from=builder /usr/local/bin/balance-sweep-ata-projector /usr/local/bin/balance-sweep-ata-projector
COPY --from=builder /usr/local/bin/balance-sweep-autodeposit-trigger /usr/local/bin/balance-sweep-autodeposit-trigger
COPY --from=builder /usr/local/bin/loyal-yield-realtime /usr/local/bin/loyal-yield-realtime
COPY --from=builder /usr/local/bin/loyal-timescale-migrations /usr/local/bin/loyal-timescale-migrations
COPY --from=builder /usr/local/bin/yield-migrations /usr/local/bin/yield-migrations
COPY --from=builder /usr/local/bin/same-mint-reserve-swap /usr/local/bin/same-mint-reserve-swap
COPY --from=builder /usr/local/bin/same-mint-yield-monitor /usr/local/bin/same-mint-yield-monitor
COPY --from=builder /usr/local/bin/fleet-opportunity-planner /usr/local/bin/fleet-opportunity-planner
COPY --from=builder /usr/local/bin/fleet-orchestration-verifier /usr/local/bin/fleet-orchestration-verifier
COPY --from=builder /usr/local/bin/fleet-orchestration-production-evidence /usr/local/bin/fleet-orchestration-production-evidence
COPY --from=builder /usr/local/bin/fleet-route-confirmer /usr/local/bin/fleet-route-confirmer
COPY --from=builder /usr/local/bin/same-mint-monitor-e2e /usr/local/bin/same-mint-monitor-e2e
COPY --from=builder /usr/local/bin/route-lookup-table-shared-catalog /usr/local/bin/route-lookup-table-shared-catalog
COPY --from=builder /usr/local/bin/route-lookup-table-provisioner /usr/local/bin/route-lookup-table-provisioner
COPY --from=builder /usr/local/bin/route-lookup-table-alert-monitor /usr/local/bin/route-lookup-table-alert-monitor
COPY --from=builder /usr/local/bin/route-lookup-table-legacy-import /usr/local/bin/route-lookup-table-legacy-import
COPY --from=builder /usr/local/bin/route-lookup-table-cleanup /usr/local/bin/route-lookup-table-cleanup

CMD ["/usr/local/bin/balance-sweep-ata-projector"]
