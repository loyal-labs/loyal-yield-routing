# syntax=docker/dockerfile:1.7

# The light-workers image now carries only loyal-yield-realtime, the one Rust
# service still on Render. The workers run on the Go engine (go/workers).
FROM rust:1.89-bookworm AS build

WORKDIR /source
COPY rust-toolchain.toml Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/source/target \
    cargo build --locked --release -p loyal-yield-realtime \
    && install -D -m 0755 target/release/loyal-yield-realtime /out/loyal-yield-realtime

FROM debian:bookworm-slim AS runtime

ARG LOYAL_IMAGE_VERSION
ENV LOYAL_IMAGE_VERSION=${LOYAL_IMAGE_VERSION}

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /out/loyal-yield-realtime /usr/local/bin/loyal-yield-realtime

CMD ["/usr/local/bin/loyal-yield-realtime"]
