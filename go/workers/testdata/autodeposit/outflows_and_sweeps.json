{
  "description": "External spending consumes newest lots first; sweeps consume oldest eligible lots first. The two directions must stay opposite or a sweep after user spending pulls money the user already spent.",
  "lots": [
    { "id": 1, "createdAt": "2026-06-16T10:00:00Z", "eligibleAfter": "2026-06-16T11:00:00Z", "remainingRaw": 3000000 },
    { "id": 2, "createdAt": "2026-06-16T11:00:00Z", "eligibleAfter": "2026-06-16T12:00:00Z", "remainingRaw": 4000000 },
    { "id": 3, "createdAt": "2026-06-16T12:00:00Z", "eligibleAfter": "2026-06-16T13:00:00Z", "remainingRaw": 5000000 }
  ],
  "externalOutflows": [
    {
      "name": "outflow smaller than the newest lot consumes only the newest lot",
      "amountRaw": 2000000,
      "expect": {
        "consumedRaw": 2000000,
        "remainingByLotId": { "1": 3000000, "2": 4000000, "3": 3000000 },
        "depletedLotIds": []
      }
    },
    {
      "name": "outflow spanning lots drains newest first and leaves the oldest intact",
      "amountRaw": 6000000,
      "expect": {
        "consumedRaw": 6000000,
        "remainingByLotId": { "1": 3000000, "2": 3000000, "3": 0 },
        "depletedLotIds": [3]
      }
    },
    {
      "name": "outflow larger than all open lots consumes what exists",
      "amountRaw": 20000000,
      "expect": {
        "consumedRaw": 12000000,
        "remainingByLotId": { "1": 0, "2": 0, "3": 0 },
        "depletedLotIds": [1, 2, 3]
      }
    }
  ],
  "sweeps": [
    {
      "name": "sweep before the oldest lot clears the one-hour delay is not actionable even with full excess",
      "now": "2026-06-16T10:59:59Z",
      "walletBalanceRaw": 12000000,
      "walletBalanceFloorRaw": 0,
      "remainingAllowanceRaw": null,
      "expect": { "kind": "no_eligible_lots" }
    },
    {
      "name": "sweep at eligibility takes oldest lots first and never the still-delayed newest lot",
      "now": "2026-06-16T12:00:00Z",
      "walletBalanceRaw": 12000000,
      "walletBalanceFloorRaw": 0,
      "remainingAllowanceRaw": null,
      "expect": {
        "kind": "sweep",
        "amountRaw": 7000000,
        "selected": [ { "lotId": 1, "amountRaw": 3000000 }, { "lotId": 2, "amountRaw": 4000000 } ]
      }
    },
    {
      "name": "wallet floor caps the sweep below the eligible lot total",
      "now": "2026-06-16T12:00:00Z",
      "walletBalanceRaw": 5000000,
      "walletBalanceFloorRaw": 2500000,
      "remainingAllowanceRaw": null,
      "expect": {
        "kind": "sweep",
        "amountRaw": 2500000,
        "cappedByWalletFloor": true,
        "selected": [ { "lotId": 1, "amountRaw": 2500000 } ]
      }
    },
    {
      "name": "exhausted allowance is a hard stop, not a zero-sized sweep",
      "now": "2026-06-16T12:00:00Z",
      "walletBalanceRaw": 12000000,
      "walletBalanceFloorRaw": 0,
      "remainingAllowanceRaw": 0,
      "expect": { "kind": "allowance_exhausted" }
    },
    {
      "name": "remaining allowance trims the sweep before the floor does",
      "now": "2026-06-16T12:00:00Z",
      "walletBalanceRaw": 12000000,
      "walletBalanceFloorRaw": 1000000,
      "remainingAllowanceRaw": 3500000,
      "expect": {
        "kind": "sweep",
        "amountRaw": 3500000,
        "cappedByRemainingAllowance": true,
        "selected": [ { "lotId": 1, "amountRaw": 3000000 }, { "lotId": 2, "amountRaw": 500000 } ]
      }
    }
  ],
  "consumption": {
    "name": "committing a decided sweep marks exactly the swept lots consumed and keeps the rest open",
    "now": "2026-06-16T12:00:00Z",
    "walletBalanceRaw": 12000000,
    "walletBalanceFloorRaw": 0,
    "remainingAllowanceRaw": null,
    "expect": {
      "consumedRaw": 7000000,
      "statusByLotId": { "1": "consumed", "2": "consumed", "3": "open" }
    }
  }
}
