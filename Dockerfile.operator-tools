# syntax=docker/dockerfile:1.7

# Rust compilation happens once in rust-image-build.yml. This Dockerfile only
# assembles the runtime image from the workflow artifact.
FROM debian:bookworm-slim AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --chmod=0755 build-artifacts/rust/loyal-timescale-migrations /usr/local/bin/loyal-timescale-migrations
COPY --chmod=0755 build-artifacts/rust/fleet-orchestration-verifier /usr/local/bin/fleet-orchestration-verifier
COPY --chmod=0755 build-artifacts/rust/fleet-orchestration-production-evidence /usr/local/bin/fleet-orchestration-production-evidence
COPY --chmod=0755 build-artifacts/rust/same-mint-monitor-e2e /usr/local/bin/same-mint-monitor-e2e
COPY --chmod=0755 build-artifacts/rust/route-lookup-table-shared-catalog /usr/local/bin/route-lookup-table-shared-catalog
COPY --chmod=0755 build-artifacts/rust/route-lookup-table-alert-monitor /usr/local/bin/route-lookup-table-alert-monitor
COPY --chmod=0755 build-artifacts/rust/route-lookup-table-legacy-import /usr/local/bin/route-lookup-table-legacy-import
COPY --chmod=0755 build-artifacts/rust/route-lookup-table-cleanup /usr/local/bin/route-lookup-table-cleanup
COPY --chmod=0755 build-artifacts/rust/signer-balance-monitor /usr/local/bin/signer-balance-monitor

CMD ["/usr/local/bin/fleet-orchestration-verifier", "--help"]
