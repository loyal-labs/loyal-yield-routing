# Loyal Hub ABI schema.
#
# This file is the byte-layout source of truth. The build script derives tags,
# lengths, offsets, seeds, and max-count constants from these declarations.

seed CONFIG_SEED config
seed HUB_AUTHORITY_SEED hub-authority
magic CONFIG_MAGIC LHUBCFG3

limit MAX_ALLOWED_MINTS 8
limit MAX_REBALANCE_TRANSFERS 16
limit MAX_FEE_BPS 10000

instruction INITIALIZE_CONFIG 0
instruction SWAP_EXACT_IN 1
instruction WITHDRAW_INVENTORY 2
instruction SET_PAUSED 3
instruction SET_MAX_FEE 4
instruction REBALANCE_INVENTORY 5

account INITIALIZE_CONFIG PAYER 0
account INITIALIZE_CONFIG CONFIG 1
account INITIALIZE_CONFIG SYSTEM_PROGRAM 2

account SET_MAX_FEE CONFIG 0
account SET_MAX_FEE ADMIN 1

account SET_PAUSED CONFIG 0
account SET_PAUSED ADMIN 1

account WITHDRAW_INVENTORY CONFIG 0
account WITHDRAW_INVENTORY ADMIN 1
account WITHDRAW_INVENTORY HUB_SOURCE 2
account WITHDRAW_INVENTORY DESTINATION 3
account WITHDRAW_INVENTORY MINT 4
account WITHDRAW_INVENTORY HUB_AUTHORITY 5
account WITHDRAW_INVENTORY TOKEN_PROGRAM 6

account SWAP_EXACT_IN CONFIG 0
account SWAP_EXACT_IN USER_VAULT 1
account SWAP_EXACT_IN USER_INPUT 2
account SWAP_EXACT_IN USER_OUTPUT 3
account SWAP_EXACT_IN HUB_INPUT 4
account SWAP_EXACT_IN HUB_OUTPUT 5
account SWAP_EXACT_IN INPUT_MINT 6
account SWAP_EXACT_IN OUTPUT_MINT 7
account SWAP_EXACT_IN HUB_AUTHORITY 8
account SWAP_EXACT_IN HUB_AUTHORIZER 9
account SWAP_EXACT_IN TOKEN_PROGRAM 10

account REBALANCE_INVENTORY CONFIG 0
account REBALANCE_INVENTORY INVENTORY_REBALANCER 1
account REBALANCE_INVENTORY TOKEN_PROGRAM 2
account REBALANCE_INVENTORY MINT 3
account REBALANCE_INVENTORY TRANSFER_ACCOUNTS_START 4
account REBALANCE_INVENTORY TRANSFER_ACCOUNT_STRIDE 3
account REBALANCE_INVENTORY SOURCE_AUTHORITY_RELATIVE 0
account REBALANCE_INVENTORY SOURCE_INVENTORY_RELATIVE 1
account REBALANCE_INVENTORY DESTINATION_INVENTORY_RELATIVE 2

record CONFIG_INIT
field ADMIN pubkey
field HUB_AUTHORIZER pubkey
field INVENTORY_REBALANCER pubkey
field MAX_FEE_BPS u16
field PAUSED bool
field LANE_COUNT u8
field MINT_COUNT u8
repeat ALLOWED_MINT pubkey MAX_ALLOWED_MINTS MINT_COUNT
end

record CONFIG_ACCOUNT
field MAGIC bytes8
field ADMIN pubkey
field HUB_AUTHORIZER pubkey
field INVENTORY_REBALANCER pubkey
field MAX_FEE_BPS u16
field PAUSED bool
field LANE_COUNT u8
field MINT_COUNT u8
repeat ALLOWED_MINT pubkey MAX_ALLOWED_MINTS MINT_COUNT
end

record SWAP_EXACT_IN_ARGS
field AMOUNT_IN u64
field AMOUNT_OUT u64
field MIN_OUT u64
field MAX_FEE_BPS u16
field LANE_ID u8
end

record WITHDRAW_INVENTORY_ARGS
field AMOUNT u64
field LANE_ID u8
end

record SET_PAUSED_ARGS
field PAUSED bool
end

record SET_MAX_FEE_ARGS
field MAX_FEE_BPS u16
end

record REBALANCE_TRANSFER
field FROM_LANE_ID u8
field TO_LANE_ID u8
field AMOUNT u64
end

record REBALANCE_INVENTORY_ARGS
field TRANSFER_COUNT u8
repeat TRANSFER rebalance_transfer MAX_REBALANCE_TRANSFERS TRANSFER_COUNT
end

instruction_record INITIALIZE_CONFIG CONFIG_INIT
instruction_record SWAP_EXACT_IN SWAP_EXACT_IN_ARGS
instruction_record WITHDRAW_INVENTORY WITHDRAW_INVENTORY_ARGS
instruction_record SET_PAUSED SET_PAUSED_ARGS
instruction_record SET_MAX_FEE SET_MAX_FEE_ARGS
instruction_record REBALANCE_INVENTORY REBALANCE_INVENTORY_ARGS
