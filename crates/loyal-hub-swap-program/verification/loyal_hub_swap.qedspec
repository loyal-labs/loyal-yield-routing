property config_domain_preserved :
  state.max_fee_bps <= 10000 and state.lane_count > 0 and state.paused <= 1
  preserved_by [initialize_config, set_max_fee, set_paused, swap_exact_in, withdraw_inventory, rebalance_inventory, rebalance_inventory_2, rebalance_inventory_3, rebalance_inventory_4, rebalance_inventory_5, rebalance_inventory_6, rebalance_inventory_7, rebalance_inventory_8, rebalance_inventory_9, rebalance_inventory_10, rebalance_inventory_11, rebalance_inventory_12, rebalance_inventory_13, rebalance_inventory_14, rebalance_inventory_15, rebalance_inventory_16]

cover successful_swap [initialize_config, swap_exact_in]
cover treasury_lifecycle [initialize_config, set_max_fee, set_paused, withdraw_inventory]
cover lane_rebalance [initialize_config, rebalance_inventory]
cover lane_rebalance_max_batch [initialize_config, rebalance_inventory_16]
